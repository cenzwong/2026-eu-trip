            "id": "pantheon", "category": "art", "titleEn": "The Pantheon", "titleZh": "萬神殿",
            "desc": "保存得最好嘅古羅馬建築，個圓頂中間有個窿 (Oculus)，落雨嗰陣啲水會喺地面排水口流走。建築學上嘅奇蹟。",
            "slang": "入面個氣場好勁，望住嗰個圓頂真係覺得自己好渺小。"
        },
        "bistecca": {
            "id": "bistecca", "category": "food", "titleEn": "Bistecca Fiorentina", "titleZh": "翡冷翠大牛扒",
            "desc": "佛羅倫斯特色 T-Bone 牛扒，一定要燒到外面焦香，入面 Medium Rare。通常按重量計，最少 1kg 起跳。",
            "slang": "啖啖肉，牛味極濃，係食貨去佛羅倫斯嘅終極目標！"
        },
        "duomo": {
            "id": "duomo", "category": "art", "titleEn": "Florence Cathedral", "titleZh": "聖母百花大教堂",
            "desc": "文藝復興時期嘅代表作，外牆用咗紅、白、綠三色大理石。布魯內萊斯基設計嘅大圓頂完全冇用支架托住。",
            "slang": "喺街角轉個彎見到佢嗰吓，真係會驚嘆到『嘩』一聲。"
        },
        "cicchetti": {
            "id": "cicchetti", "category": "food", "titleEn": "Venetian Cicchetti", "titleZh": "威尼斯小食",
            "desc": "威尼斯版嘅 Tapas。當地人收工會去 Bacaro (小酒吧) 叫杯酒加幾塊 Cicchetti，例如炸魚、炸丸或者多士配鱈魚醬。",
            "slang": "企喺水邊飲杯酒食吓嘢，呢啲先至係威尼斯嘅生活態度。"
        },
        "gondola": {
            "id": "gondola", "category": "sight", "titleEn": "Gondola", "titleZh": "貢多拉",
            "desc": "威尼斯傳統手工造嘅黑色長形船。雖然貴，但穿梭喺啲窄窄嘅水道入面，角度完全唔同。",
            "slang": "一生人點都要坐一次，雖然幾舊水港幣，但嗰種浪漫係無價嘅。"
        }
